# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# N-Remote integration
# Comma-separated origins a launch returnUrl may point at (e.g. https://buildnow.n-remote.com)
VITE_ALLOWED_RETURN_ORIGINS=
# Comma-separated origins an upload target may point at (e.g. the Supabase project host)
VITE_ALLOWED_UPLOAD_ORIGINS=
# Product name shown in the editor
VITE_BRAND_NAME=
# Logo image URL shown in the editor
VITE_BRAND_LOGO_URL=
# OpenReel cloud URL (empty by default = disabled)
VITE_OPENREEL_CLOUD_URL=
