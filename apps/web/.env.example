# PostHog Analytics (optional)
# Get your keys at https://posthog.com
# Leave unset (or empty) to use the default (analytics off).
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# N-Remote integration
# The two allowlists are REQUIRED for launch and delivery to work. With both
# empty, every launch is refused and the editor behaves as plain OpenReel.
# Comma-separated origins a launch returnUrl may point at (e.g. https://buildnow.n-remote.com)
VITE_ALLOWED_RETURN_ORIGINS=
# Comma-separated origins an upload target may point at (e.g. the Supabase project host)
VITE_ALLOWED_UPLOAD_ORIGINS=
# Product name shown in the editor
# Leave unset (or empty) to use the default.
VITE_BRAND_NAME=
# Logo image: same-origin path only, e.g. /brand/logo.svg under apps/web/public
# Leave unset (or empty) to use the default.
VITE_BRAND_LOGO_URL=
# OpenReel cloud URL (share links, cloud templates)
# Leave unset (or empty) to use the default (cloud off).
VITE_OPENREEL_CLOUD_URL=
